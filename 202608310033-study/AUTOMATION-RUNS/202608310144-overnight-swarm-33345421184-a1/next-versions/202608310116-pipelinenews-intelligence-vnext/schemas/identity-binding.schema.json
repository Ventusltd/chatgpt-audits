{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://globalgrid2050.com/schemas/pipelinenews-identity-binding-v1.json",
  "title": "Reviewed identity binding",
  "type": "object",
  "additionalProperties": false,
  "x-review-status": "UNREVIEWED",
  "x-classification": "inferred",
  "required": [
    "binding_id",
    "subject_id",
    "object_id",
    "binding_role",
    "decision",
    "evidence_event_ids",
    "review_status"
  ],
  "properties": {
    "binding_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "binding_role": {
      "enum": [
        "PRIMARY_MATCH",
        "RELATED_DEVELOPMENT",
        "RELATED_CONTEXT",
        "NO_BINDING"
      ]
    },
    "decision": {
      "enum": [
        "ACCEPT",
        "ABSTAIN",
        "REJECT",
        "RETRACT"
      ]
    },
    "evidence_event_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_status": {
      "enum": [
        "UNREVIEWED",
        "REVIEWED",
        "REJECTED",
        "RETRACTED"
      ]
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
